<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 p-10" >
        <h3 class="text-3xl p-5 mb-5">Login Your Account:</h3>
        <form action="/login" method="post">
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-800 rounded-md m-3" required type="text" name="email" placeholder="email">
            <input class="px-3 py-2 outline-none bg-transparent border-2 border-zinc-800 rounded-md m-3" required type="password" name="password" placeholder="password">
            <input class="px-5 py-2 outline-none  m-3 border-2 border-zinc-800 rounded-md bg-blue-500" type="submit" value="Login Account">
        </form>
    </div>
</body>
</html>