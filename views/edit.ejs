<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="flex w-full justify-end mr-5">
            <a href="/logout" class="bg-red-500 border-none rounded-md p-3 text-sm">Logout</a>
        </div>
        <h3 class="text-3xl mb-5">Edit page</h3>
        
        <h5 class="mb-5">You Can Edit Your Post Now !</h5>

        <!-- creating a post form  -->
        <form method="post" action="/update/<%= post._id %>">
            <textarea name="content" id="" class="w-1/3 resize-none bg-transparent border-2 rounded-md border-zinc-800 p-3 outline-none block" placeholder="What's on your mind ?"><%= post.content %></textarea>
            <input type="submit" class="px-5 py-3 bg-yellow-500 mt-5 rounded-md w-40 text-md text-black" value="Update Post">          
        </form>      
    </div>
</body>
</html>