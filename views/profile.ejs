<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="flex w-full justify-end mr-5">
            <a href="/logout" class="bg-red-500 border-none rounded-md p-3 text-sm">Logout</a>
        </div>
        <h3 class="text-3xl mb-5">Profile page</h3>
        <h4 class="text-2xl mb-3"><span class="font-light text-green-500">Hello</span>, <%= user.name %> 👋 </h4>
        <h5 class="mb-5">You can create a new post now !</h5>

        <!-- creating a post form  -->
         <form method="post" action="/post">
            <textarea name="content" id="" class="w-1/3 resize-none bg-transparent border-2 rounded-md border-zinc-800 p-3 outline-none block" placeholder="What's on your mind ?"></textarea>
            <input type="submit" class="px-5 py-3 bg-blue-500 mt-5 rounded-md w-40 text-sm" value="Create New Post">
            

         </form>

         <div class="posts mt-10 ">
            <h3 class="text-2xl text-zinc-400">Your Posts!</h3>
            <div class="post-container mt-5">
                <% if (user.posts && user.posts.length > 0) { %>
                    <% user.posts.reverse().forEach(function(post)  { %>
                    <div class="post w-1/3 p-4 border-[1px] border-zinc-800 rounded-md mt-5 bg-zinc-700 mb-3">
                        <h4 class="text-green-500 mb-2"><%= user.username %> </h4>
                        <p class="text-sm tracking-tight"><%= post.content %></p>
                        <small class="mt-2 inline-block"><%= post.likes.length %> Likes</small>
                        <div class="btns flex gap-4">
                            <a href="/like/<%= post._id %>" class="border-2 rounded-md mt-2 border-zinc-800"><%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %>👍</a><a href="edit/<%= post._id %>" class="border-2 rounded-md mt-2 border-zinc-800">✏️</a>
                        </div>
                    </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-zinc-500">No posts yet. Create your first post above!</p>
                <% } %>
            </div>

         </div>

    </div>
</body>
</html>